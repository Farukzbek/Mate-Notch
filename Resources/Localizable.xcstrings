          }
        }
      }
    },
    "iCloud senkronizasyonunun geçici dosyaları. Silinirse gerektiğinde yeniden indirilir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporary files of iCloud sync. Downloaded again when needed if deleted."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporäre Dateien der iCloud-Synchronisierung. Nach dem Löschen werden sie bei Bedarf erneut geladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos temporales de la sincronización de iCloud. Si se eliminan, se descargan de nuevo cuando hagan falta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers temporaires de la synchronisation iCloud. S'ils sont supprimés, ils sont retéléchargés au besoin."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos temporários da sincronização do iCloud. Se excluídos, são baixados de novo quando necessário."
          }
        }
      }
    },
    "iOS simülatörlerinin geçici önbelleği. Silinirse simülatör gerektiğinde yeniden oluşturur.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporary cache of iOS simulators. The simulator recreates it when needed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporärer Cache der iOS-Simulatoren. Der Simulator erstellt ihn bei Bedarf neu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Caché temporal de los simuladores de iOS. El simulador lo recrea cuando hace falta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache temporaire des simulateurs iOS. Le simulateur le recrée au besoin."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache temporário dos simuladores de iOS. O simulador o recria quando precisa."
          }
        }
      }
    },
