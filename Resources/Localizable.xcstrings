    },
    "Xcode'un kod tamamlama ve dizin önbellekleri. Silinirse Xcode bir sonraki açılışta yeniden oluşturur.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Codevervollständigungs- und Index-Caches von Xcode. Xcode erstellt sie beim nächsten Start neu, wenn sie gelöscht wurden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode's code completion and index caches. Xcode recreates them on next launch if deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cachés de autocompletado de código e índices de Xcode. Xcode los recrea en el próximo inicio si se eliminan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches de complétion de code et d'index de Xcode. Xcode les recrée au prochain lancement s'ils sont supprimés."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches de autocompletar código e de índices do Xcode. O Xcode os recria na próxima abertura se forem excluídos."
          }
        }
      }
    },
    "Yaklaşan etkinlik yok": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine anstehenden Termine"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No upcoming events"
          }
        },
