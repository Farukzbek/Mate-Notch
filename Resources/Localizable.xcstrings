          }
        }
      }
    },
    "Ses kaydı izni gerekli: Sistem Ayarları › Gizlilik ve Güvenlik › Ekran ve Sistem Ses Kaydı'nda Mate Notch'u aç.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berechtigung für Tonaufnahme nötig: Aktiviere Mate Notch in Systemeinstellungen › Datenschutz & Sicherheit › Bildschirm- & Systemaudioaufnahme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio recording permission needed: turn on Mate Notch in System Settings › Privacy & Security › Screen & System Audio Recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesita permiso de grabación de audio: activa Mate Notch en Ajustes del Sistema › Privacidad y seguridad › Grabación de pantalla y audio del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisation d'enregistrement audio requise : activez Mate Notch dans Réglages Système › Confidentialité et sécurité › Enregistrement de l'écran et de l'audio système."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permissão de gravação de áudio necessária: ative o Mate Notch em Ajustes do Sistema › Privacidade e Segurança › Gravação de Tela e Áudio do Sistema."
          }
        }
      }
    },
