    "%@ kullanılıyor": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird verwendet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Using %@"
          }
        },
        "es": {
          "stringUnit": {
