{
  "sourceLanguage": "tr",
  "strings": {
    "": {},
    "\n\nBu işlem geri alınamaz. Uygulamalar gerekli önbellek dosyalarını gerektiğinde yeniden oluşturur.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nThis can't be undone. Apps recreate the cache files they need when required."
          }
        }
      }
    },
    "\n\nDikkat: Seçtiklerin arasında silinmesi daha etkili olan öğeler var (çevrimdışı şarkılar, Çöp Kutusu vb.).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nCaution: your selection includes items with bigger consequences (offline songs, Trash, etc.)."
          }
        }
      }
    },
    " · %lld dosya silinemedi (kullanımda veya izin yok)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " · %lld files couldn't be deleted (in use or no permission)"
          }
        }
      }
    },
    " · şarja tak": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " · plug in"
          }
        }
      }
    },
    "\"%@\" klasörü: bu ada ait uygulama/araç önbelleği (uygulama bulunamadı). Genellikle silinirse yeniden oluşturulur.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" folder: cache of the app/tool with this name (app not found). Usually recreated when deleted."
          }
        }
      }
    },
    "%%%lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%%%lld"
          }
        }
      }
    },
    "%@ Ya da Ayarlar'dan bir bulut model (Claude, ChatGPT, Gemini) bağla.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Or connect a cloud model (Claude, ChatGPT, Gemini) in Settings."
          }
        }
      }
    },
    "%@ bağlı değil": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ isn't connected"
          }
        }
      }
    },
    "%@ kullanılıyor": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Using %@"
          }
        }
      }
    },
    "%@ uygulamasının geçici dosyaları (görseller, indirilen veriler). Silinirse uygulama gerektiğinde yeniden oluşturur; ilk açılış biraz yavaş olabilir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporary files of %@ (images, downloaded data). If deleted the app recreates them when needed; the first launch may be a bit slower."
          }
        }
      }
    },
    "%@ önbelleği": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cache"
          }
        }
      }
    },
