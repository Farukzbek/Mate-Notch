          "stringUnit": {
            "state": "translated",
            "value": "Home"
          }
        }
      }
    },
    "Ana Sayfa'da seçtiğin şehrin hava durumu görünür. Konumun kullanılmaz, yalnızca şehir adı gönderilir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weather for your chosen city shows on Home. Your location isn't used; only the city name is sent."
          }
        }
      }
    },
    "Ana Sayfa'da sıradaki etkinlik görünür; toplantıda Katıl düğmesi çıkar ve başlamadan 5 dk önce uyarır.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next event shows on Home; meetings get a Join button and an alert 5 min before they start."
          }
        }
      }
    },
    "Ana Sayfa'da sıradaki etkinliği ve toplantı hatırlatmasını gösterir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the next event and meeting reminder on Home."
          }
        }
      }
    },
    "Anahtarı %@ adresinden alabilirsin.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can get a key at %@."
