          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecionar tudo"
          }
        }
      }
    },
    "Her biri 20 MB'dan küçük, çeşitli uygulamaların geçici dosyaları. Uygulamalar gerektiğinde yeniden oluşturur.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporary files of various apps, each under 20 MB. Apps recreate them when needed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporäre Dateien verschiedener Apps, jeweils unter 20 MB. Apps erstellen sie bei Bedarf neu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos temporales de varias apps, cada uno de menos de 20 MB. Las apps los vuelven a crear cuando los necesitan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers temporaires de diverses apps, chacun de moins de 20 Mo. Les apps les recréent au besoin."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos temporários de vários apps, cada um com menos de 20 MB. Os apps os recriam quando precisam."
          }
        }
      }
    },
    "Her özelliği açıp kapatabilir, deneyebilir ya da atlayabilirsin. Hepsine Ayarlar'dan da ulaşırsın.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn each feature on or off, try it, or skip it. You can reach all of them in Settings too."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte jede Funktion ein oder aus, probiere sie aus oder überspringe sie. Du erreichst alle auch in den Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa o desactiva cada función, pruébala u omítela. También puedes acceder a todas en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez ou désactivez chaque fonction, essayez-la ou passez-la. Vous les retrouvez toutes dans les Réglages."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative ou desative cada recurso, experimente ou pule. Você também acessa todos nos Ajustes."
          }
        }
      }
    },
