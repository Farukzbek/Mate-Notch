    "Ana Sayfa": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Start"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Home"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accueil"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Início"
          }
        }
      }
    },
    "Ana Sayfa'da seçtiğin şehrin hava durumu görünür. Konumun kullanılmaz, yalnızca şehir adı gönderilir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Wetter deiner gewählten Stadt erscheint auf „Start“. Dein Standort wird nicht verwendet; nur der Stadtname wird gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weather for your chosen city shows on Home. Your location isn't used; only the city name is sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tiempo de la ciudad que elijas aparece en Inicio. No se usa tu ubicación; solo se envía el nombre de la ciudad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La météo de la ville choisie s'affiche sur Accueil. Votre position n'est pas utilisée ; seul le nom de la ville est envoyé."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O clima da cidade escolhida aparece em Início. Sua localização não é usada; só o nome da cidade é enviado."
          }
        }
      }
    },
    "Ana Sayfa'da sıradaki etkinlik görünür; toplantıda Katıl düğmesi çıkar ve başlamadan 5 dk önce uyarır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der nächste Termin erscheint auf „Start“; Meetings bekommen eine Beitreten-Taste und 5 Min. vor Beginn eine Erinnerung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next event shows on Home; meetings get a Join button and an alert 5 min before they start."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El próximo evento aparece en Inicio; las reuniones tienen un botón Unirse y un aviso 5 min antes de empezar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le prochain événement s'affiche sur Accueil ; les réunions ont un bouton Rejoindre et une alerte 5 min avant le début."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O próximo evento aparece em Início; reuniões ganham um botão Entrar e um aviso 5 min antes de começar."
          }
        }
      }
    },
    "Ana Sayfa'da sıradaki etkinliği ve toplantı hatırlatmasını gösterir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt den nächsten Termin und die Meeting-Erinnerung auf „Start“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the next event and meeting reminder on Home."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra el próximo evento y el recordatorio de reunión en Inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche le prochain événement et le rappel de réunion sur Accueil."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra o próximo evento e o lembrete de reunião em Início."
          }
        }
      }
    },
    "Anahtarı %@ adresinden alabilirsin.": {
      "localizations": {
