    "Ses ve parlaklık": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lautstärke und Helligkeit"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume & brightness"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumen y brillo"
          }
        },
        "fr": {
          "stringUnit": {
