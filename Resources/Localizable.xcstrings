    "Chrome'un sitelerden sakladığı geçici dosyalar. Silinirse siteler ilk açılışta yavaş yüklenebilir; oturumların silinmez.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporary files Chrome keeps from sites. If deleted, sites may load slower the first time; your sessions stay."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporäre Dateien, die Chrome von Websites behält. Nach dem Löschen laden Websites beim ersten Mal evtl. langsamer; deine Sitzungen bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos temporales que Chrome guarda de los sitios. Si se eliminan, los sitios pueden cargar más lento la primera vez; tus sesiones se mantienen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers temporaires que Chrome conserve des sites. Si vous les supprimez, les sites peuvent se charger plus lentement la première fois ; vos sessions sont conservées."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos temporários que o Chrome guarda dos sites. Se excluídos, os sites podem carregar mais devagar na primeira vez; suas sessões continuam."
          }
        }
      }
    },
