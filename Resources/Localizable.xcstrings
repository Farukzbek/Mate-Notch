    "İndirilenler klasörüne inen dosyaların ilerlemesi notch'ta görünür. macOS bir kez izin sorar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Fortschritt von Dateien, die in deinen Download-Ordner kommen, erscheint im Notch. macOS fragt einmal nach der Berechtigung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Progress of files landing in your Downloads folder shows in the notch. macOS asks for permission once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El progreso de los archivos que llegan a tu carpeta Descargas aparece en el notch. macOS pide permiso una vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La progression des fichiers arrivant dans votre dossier Téléchargements s'affiche dans le notch. macOS demande l'autorisation une fois."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O progresso dos arquivos que chegam à sua pasta Downloads aparece no notch. O macOS pede permissão uma vez."
          }
        }
      }
    },
