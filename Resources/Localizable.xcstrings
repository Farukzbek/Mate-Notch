    "Seçtiğin şehirlerin saati Sistem sekmesinin altında görünür; yanında senin saatinle farkı yazar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Uhrzeit deiner gewählten Städte erscheint unter dem System-Tab, daneben der Unterschied zu deiner Zeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The time in your chosen cities shows under the System tab, with the difference from your time next to it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La hora de las ciudades que elijas aparece bajo la pestaña Sistema, con la diferencia respecto a tu hora al lado."
          }
        },
        "fr": {
