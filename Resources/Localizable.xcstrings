    },
    "Odak (Rahatsız Etmeyin) açıkken notch'ta ay simgesi gösterir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows a moon icon in the notch while Focus (Do Not Disturb) is on."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt im Notch ein Mondsymbol, solange Fokus (Nicht stören) an ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra un icono de luna en el notch mientras el Enfoque (No molestar) esté activado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche une icône de lune dans le notch tant que la Concentration (Ne pas déranger) est activée."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra um ícone de lua no notch enquanto o Foco (Não perturbe) estiver ativado."
          }
        }
      }
    },
    "Odak (Rahatsız Etmeyin) açıkken notch'ta ay simgesi gösterir. macOS bir kez izin sorar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows a moon icon in the notch while Focus (Do Not Disturb) is on. macOS asks for permission once."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt im Notch ein Mondsymbol, solange Fokus (Nicht stören) an ist. macOS fragt einmal nach der Berechtigung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra un icono de luna en el notch mientras el Enfoque (No molestar) esté activado. macOS pide permiso una vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche une icône de lune dans le notch tant que la Concentration (Ne pas déranger) est activée. macOS demande l'autorisation une fois."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra um ícone de lua no notch enquanto o Foco (Não perturbe) estiver ativado. O macOS pede permissão uma vez."
          }
        }
      }
    },
