    "Bluetooth kulaklık bağlanınca adı ve pil durumu (AirPods dahil) kısa süre görünür.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When Bluetooth headphones connect, their name and battery (including AirPods) show briefly."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Bluetooth-Kopfhörer verbunden werden, erscheinen kurz Name und Akku (auch AirPods)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando se conectan unos auriculares Bluetooth, se muestran brevemente su nombre y batería (incluidos AirPods)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
