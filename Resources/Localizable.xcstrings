          "stringUnit": {
            "state": "translated",
            "value": "Volume"
          }
        }
      }
    },
    "Ses açma/kısma ve parlaklık açma/kısma tuşlarının her basışta kaç yüzde değişeceği. Bu ayar yalnızca yukarıdaki seçenek açıkken geçerli (tuşları Mate Notch işlediği için).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How many percent the volume and brightness keys change per press. This only applies while the option above is on (because Mate Notch handles the keys)."
          }
        }
      }
    },
