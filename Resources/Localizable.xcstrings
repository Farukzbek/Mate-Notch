    "Safari web önbelleği": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari web cache"
          }
        }
      }
    },
    "Safari'nin sitelerden sakladığı görseller, betikler ve veriler. Silinirse siteler ilk açılışta biraz yavaş yüklenir. Oturumların, şifrelerin ve geçmişin silinmez.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Images, scripts and data Safari keeps from sites. If deleted, sites load a little slower at first. Your sessions, passwords and history are kept."
          }
        }
      }
    },
    "Sağ %%%lld": {
      "localizations": {
