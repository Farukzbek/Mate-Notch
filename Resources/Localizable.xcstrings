          }
        }
      }
    },
    "Xcode projelerinin derleme ara dosyaları. Silinirse projeler bir sonraki derlemede baştan derlenir (ilk derleme uzun sürer).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwischendateien von Xcode-Projekten. Nach dem Löschen werden Projekte beim nächsten Mal von Grund auf neu gebaut (der erste Build dauert länger)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Intermediate build files of Xcode projects. If deleted, projects are rebuilt from scratch next time (the first build takes longer)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos intermedios de compilación de proyectos de Xcode. Si se eliminan, los proyectos se recompilan desde cero la próxima vez (la primera compilación tarda más)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers intermédiaires de build des projets Xcode. Si vous les supprimez, les projets sont recompilés entièrement la prochaine fois (le premier build est plus long)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos intermediários de compilação de projetos do Xcode. Se excluídos, os projetos são recompilados do zero na próxima vez (a primeira compilação demora mais)."
          }
        }
      }
    },
