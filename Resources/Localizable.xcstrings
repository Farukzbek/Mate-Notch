    "Kulaklık, fare ve klavyenin pil seviyesini okur; düşük pil uyarısı verir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest den Akkustand von Kopfhörern, Maus und Tastatur und warnt bei niedrigem Akkustand."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads the battery level of headphones, mouse and keyboard and gives low battery alerts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee el nivel de batería de auriculares, ratón y teclado y avisa cuando está baja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit le niveau de batterie du casque, de la souris et du clavier et alerte quand il est faible."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê o nível de bateria de fones, mouse e teclado e avisa quando está baixo."
          }
        }
      }
    },
