          }
        }
      }
    },
    "Odak izin ayarlarını aç": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Focus permission settings"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fokus-Berechtigungseinstellungen öffnen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir ajustes de permiso de Enfoque"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir les réglages d'autorisation Concentration"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir ajustes de permissão do Foco"
          }
        }
      }
    },
    "Mac'inde bir Odak (Rahatsız Etmeyin, Çalışma, Uyku…) açılınca notch'un yanında ay simgesi çıkar, maskot sakinleşir. macOS bir kez izin sorar; yalnızca Odak'ın açık olup olmadığı okunur, hangi Odak olduğu değil.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a Focus (Do Not Disturb, Work, Sleep…) turns on, a moon icon appears next to the notch and the mascot calms down. macOS asks for permission once; only whether Focus is on is read, not which one."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ein Fokus (Nicht stören, Arbeit, Schlafen …) aktiv wird, erscheint neben dem Notch ein Mondsymbol und das Maskottchen beruhigt sich. macOS fragt einmal nach der Berechtigung; gelesen wird nur, ob ein Fokus an ist, nicht welcher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando se activa un Enfoque (No molestar, Trabajo, Dormir…), aparece un icono de luna junto al notch y la mascota se calma. macOS pide permiso una vez; solo se lee si hay un Enfoque activo, no cuál."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand une Concentration (Ne pas déranger, Travail, Sommeil…) s'active, une icône de lune apparaît à côté du notch et la mascotte se calme. macOS demande l'autorisation une fois ; seule l'activation d'une Concentration est lue, pas laquelle."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando um Foco (Não perturbe, Trabalho, Dormir…) é ativado, um ícone de lua aparece ao lado do notch e o mascote se acalma. O macOS pede permissão uma vez; só se lê se um Foco está ativo, não qual."
          }
        }
      }
    },
    "Sıcaklık birimi": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temperature unit"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Temperatureinheit"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unidad de temperatura"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Unité de température"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Unidade de temperatura"
          }
        }
      }
    },
    "Hava durumu Open-Meteo'dan gelir (anahtar gerekmez); yalnızca seçtiğin şehrin adı/konumu gönderilir, Mac'inin konumu kullanılmaz.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weather comes from Open-Meteo (no key needed); only the name/location of the city you pick is sent, never your Mac's location."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Wetter kommt von Open-Meteo (kein Schlüssel nötig); nur Name/Ort der gewählten Stadt wird gesendet, nie der Standort deines Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tiempo viene de Open-Meteo (sin clave); solo se envía el nombre/ubicación de la ciudad que elijas, nunca la ubicación de tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La météo vient d'Open-Meteo (aucune clé requise) ; seuls le nom/la position de la ville choisie sont envoyés, jamais la position de votre Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O clima vem do Open-Meteo (sem chave); só o nome/local da cidade escolhida é enviado, nunca a localização do seu Mac."
          }
        }
      }
    },
    "Kamera/mikrofon göstergesi izin gerektirmez. İndirilenler için macOS bir kez izin sorar.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera/microphone indicator needs no permission. macOS asks once for Downloads."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera-/Mikrofonanzeige braucht keine Berechtigung. macOS fragt einmal für Downloads."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El indicador de cámara/micrófono no necesita permiso. macOS pregunta una vez por Descargas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'indicateur caméra/micro ne nécessite aucune autorisation. macOS demande une fois pour Téléchargements."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O indicador de câmera/microfone não precisa de permissão. O macOS pergunta uma vez para Downloads."
          }
        }
      }
    },
