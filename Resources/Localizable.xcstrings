    "Erişilebilirlik ayarlarını aç": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedienungshilfen-Einstellungen öffnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Accessibility settings"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir ajustes de Accesibilidad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir les réglages d'Accessibilité"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir ajustes de Acessibilidade"
          }
        }
      }
    },
    "Erişilebilirlik izni bekleniyor: Sistem Ayarları › Gizlilik ve Güvenlik › Erişilebilirlik'te Mate Notch'u aç. Açınca kendiliğinden başlar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warte auf die Bedienungshilfen-Berechtigung: Aktiviere Mate Notch in Systemeinstellungen › Datenschutz & Sicherheit › Bedienungshilfen. Er startet von selbst, sobald er aktiviert ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for Accessibility permission: turn on Mate Notch in System Settings › Privacy & Security › Accessibility. It starts by itself once enabled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando el permiso de Accesibilidad: activa Mate Notch en Ajustes del Sistema › Privacidad y seguridad › Accesibilidad. Se inicia solo en cuanto se active."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente de l'autorisation Accessibilité : activez Mate Notch dans Réglages Système › Confidentialité et sécurité › Accessibilité. Il démarre tout seul une fois activé."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguardando a permissão de Acessibilidade: ative o Mate Notch em Ajustes do Sistema › Privacidade e Segurança › Acessibilidade. Ele começa sozinho assim que for ativado."
          }
        }
      }
    },
