    "Apple Intelligence kapalı: Sistem Ayarları › Apple Intelligence ve Siri'den aç.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ist aus: Aktiviere es in Systemeinstellungen › Apple Intelligence & Siri."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence is off: turn it on in System Settings › Apple Intelligence & Siri."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence está desactivado: actívalo en Ajustes del Sistema › Apple Intelligence y Siri."
