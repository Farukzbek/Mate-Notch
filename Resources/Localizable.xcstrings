    "Tüm ayarlarını bir dosyaya kaydeder ya da bir dosyadan geri yükler. İçe aktarınca uygulama yeniden açılır.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichert alle deine Einstellungen in einer Datei oder stellt sie aus einer wieder her. Die App startet nach dem Import neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves all your settings to a file or restores them from one. The app relaunches after importing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda todos tus ajustes en un archivo o los restaura desde uno. La app se reinicia tras importar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre tous vos réglages dans un fichier ou les restaure depuis un fichier. L'app redémarre après l'importation."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva todos os seus ajustes em um arquivo ou os restaura de um. O app reinicia após importar."
          }
        }
      }
    },
