    "Cihaz içi model bu macOS sürümünde yok. Ayarlar'dan bir bulut model bağla.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The on-device model isn't available on this macOS version. Connect a cloud model in Settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell auf dem Gerät ist unter dieser macOS-Version nicht verfügbar. Verbinde in den Einstellungen ein Cloud-Modell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo en el dispositivo no está disponible en esta versión de macOS. Conecta un modelo en la nube en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
