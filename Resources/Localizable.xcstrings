    "Sabitlenen pano öğeleri hiçbir zaman silinmez.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angeheftete Elemente der Zwischenablage werden nie gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinned clipboard items are never deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos fijados del portapapeles nunca se eliminan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments épinglés du presse-papiers ne sont jamais supprimés."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Itens fixados da área de transferência nunca são excluídos."
          }
        }
      }
    },
    "Safari web önbelleği": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari-Web-Cache"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari web cache"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Caché web de Safari"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache web de Safari"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache da web do Safari"
          }
        }
      }
    },
    "Safari'nin sitelerden sakladığı görseller, betikler ve veriler. Silinirse siteler ilk açılışta biraz yavaş yüklenir. Oturumların, şifrelerin ve geçmişin silinmez.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder, Skripte und Daten, die Safari von Websites behält. Nach dem Löschen laden Websites anfangs etwas langsamer. Deine Sitzungen, Passwörter und dein Verlauf bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Images, scripts and data Safari keeps from sites. If deleted, sites load a little slower at first. Your sessions, passwords and history are kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imágenes, scripts y datos que Safari guarda de los sitios. Si se eliminan, los sitios cargan algo más lento al principio. Se conservan tus sesiones, contraseñas e historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Images, scripts et données que Safari conserve des sites. Si vous les supprimez, les sites se chargent un peu plus lentement au début. Vos sessions, mots de passe et historique sont conservés."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagens, scripts e dados que o Safari guarda dos sites. Se excluídos, os sites carregam um pouco mais devagar no início. Suas sessões, senhas e histórico são mantidos."
          }
        }
      }
    },
