    "Bağladığın iPhone/iPad için indirilen hata ayıklama dosyaları. Silinirse cihaz bağlandığında yeniden indirilir ve bu uzun sürebilir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Debug-Supportdateien, die für verbundene iPhones/iPads geladen wurden. Nach dem Löschen werden sie beim Verbinden erneut geladen, was dauern kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Debug support files downloaded for iPhones/iPads you connected. If deleted they're downloaded again on connection, which can take a while."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos de soporte de depuración descargados para los iPhone/iPad que conectaste. Si se eliminan, se descargan de nuevo al conectar, lo que puede tardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers de support de débogage téléchargés pour les iPhone/iPad connectés. S'ils sont supprimés, ils sont retéléchargés à la connexion, ce qui peut prendre du temps."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos de suporte de depuração baixados para os iPhones/iPads que você conectou. Se excluídos, são baixados de novo ao conectar, o que pode demorar."
          }
        }
      }
    },
