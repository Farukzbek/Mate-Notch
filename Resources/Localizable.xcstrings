    "Metin yaz, panodan al veya bir şey sor…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type text, paste from clipboard or ask something…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Text eingeben, aus der Zwischenablage einfügen oder etwas fragen …"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe texto, pega del portapapeles o pregunta algo…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez du texte, collez depuis le presse-papiers ou posez une question…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite um texto, cole da área de transferência ou pergunte algo…"
          }
        }
      }
    },
    "Metni özetle, düzelt, çevir ya da bir şey sor. Varsayılan olarak cihaz içi Apple modeli çalışır; istersen bulut model bağlarsın.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Summarize, fix or translate text, or ask something. The on-device Apple model runs by default; you can connect a cloud model if you like."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Texte zusammenfassen, korrigieren oder übersetzen oder etwas fragen. Standardmäßig läuft das Apple-Modell auf dem Gerät; du kannst ein Cloud-Modell verbinden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume, corrige o traduce texto, o pregunta algo. Por defecto se ejecuta el modelo de Apple en el dispositivo; puedes conectar un modelo en la nube si quieres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Résumez, corrigez ou traduisez du texte, ou posez une question. Le modèle Apple sur l'appareil est utilisé par défaut ; vous pouvez connecter un modèle cloud si vous le souhaitez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Resuma, corrija ou traduza textos, ou pergunte algo. Por padrão roda o modelo da Apple no dispositivo; você pode conectar um modelo na nuvem se quiser."
          }
        }
      }
    },
