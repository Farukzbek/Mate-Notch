    "Kulaklık, fare ve klavyenin pil seviyesini okur; düşük pil uyarısı verir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads the battery level of headphones, mouse and keyboard and gives low battery alerts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest den Akkustand von Kopfhörern, Maus und Tastatur und warnt bei niedrigem Akkustand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee el nivel de batería de auriculares, ratón y teclado y avisa cuando está baja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit le niveau de batterie du casque, de la souris et du clavier et alerte quand il est faible."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê o nível de bateria de fones, mouse e teclado e avisa quando está baixo."
          }
        }
      }
    },
    "Kulaklık/cihaz pilini açık notch'un başlığında göster": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show headphone/device battery in the open notch header"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Akku von Kopfhörern/Geräten in der Kopfzeile des geöffneten Notch anzeigen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar la batería de auriculares/dispositivos en el encabezado del notch abierto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher la batterie du casque/des appareils dans l'en-tête du notch ouvert"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar a bateria de fones/dispositivos no cabeçalho do notch aberto"
          }
        }
