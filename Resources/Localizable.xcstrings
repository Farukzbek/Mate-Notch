    "Yaklaşan etkinliğin yok. 🎉": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast keine anstehenden Termine. 🎉"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have no upcoming events. 🎉"
          }
        },
        "es": {
