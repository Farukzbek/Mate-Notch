    "Swift paketlerinin indirilen kaynakları. Silinirse projeler derlenirken yeniden indirilir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geladene Quellen von Swift-Paketen. Nach dem Löschen werden sie beim Bauen der Projekte erneut geladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloaded sources of Swift packages. If deleted they're downloaded again when projects build."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuentes descargadas de paquetes Swift. Si se eliminan, se descargan de nuevo al compilar los proyectos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sources téléchargées des paquets Swift. Si elles sont supprimées, elles sont retéléchargées à la compilation des projets."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fontes baixadas de pacotes Swift. Se excluídas, são baixadas de novo quando os projetos compilam."
          }
        }
      }
    },
