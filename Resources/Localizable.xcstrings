          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporary cache of iOS simulators. The simulator recreates it when needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Caché temporal de los simuladores de iOS. El simulador lo recrea cuando hace falta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
