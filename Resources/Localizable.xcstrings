    "Çöpe attığın dosyalar. DİKKAT: Burası boşaltılırsa dosyalar kalıcı olarak silinir ve geri getirilemez.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files you've trashed. CAUTION: if emptied, the files are permanently deleted and can't be recovered."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien, die du in den Papierkorb gelegt hast. ACHTUNG: Wird er geleert, werden die Dateien endgültig gelöscht und lassen sich nicht wiederherstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos que enviaste a la Papelera. PRECAUCIÓN: si se vacía, los archivos se eliminan de forma permanente y no se pueden recuperar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers que vous avez mis à la corbeille. ATTENTION : si elle est vidée, les fichiers sont supprimés définitivement et irrécupérables."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos que você enviou para a Lixeira. ATENÇÃO: se for esvaziada, os arquivos são excluídos permanentemente e não podem ser recuperados."
          }
        }
      }
    },
