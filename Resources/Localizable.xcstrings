    "Gereksiz önbellek ve günlük dosyalarını neye ait olduklarıyla listeler; sen onaylamadan hiçbir şey silmez.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Listet unnötige Cache- und Protokolldateien mit ihrer Zugehörigkeit auf; ohne deine Zustimmung wird nichts gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lists unneeded cache and log files with what they belong to; nothing is deleted without your approval."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enumera archivos de caché y registro innecesarios con lo que les corresponde; no se elimina nada sin tu aprobación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Liste les fichiers de cache et de journal inutiles avec leur origine ; rien n'est supprimé sans votre accord."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista arquivos de cache e de log desnecessários e a quem pertencem; nada é excluído sem a sua aprovação."
          }
        }
      }
    },
