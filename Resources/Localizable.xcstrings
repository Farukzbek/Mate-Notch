        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra un icono de luna en el notch mientras el Enfoque (No molestar) esté activado. macOS pide permiso una vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche une icône de lune dans le notch tant que la Concentration (Ne pas déranger) est activée. macOS demande l'autorisation une fois."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra um ícone de lua no notch enquanto o Foco (Não perturbe) estiver ativado. O macOS pede permissão uma vez."
