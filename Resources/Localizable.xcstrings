            "value": "Volume"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume"
          }
        }
      }
    },
    "Ses açma/kısma ve parlaklık açma/kısma tuşlarının her basışta kaç yüzde değişeceği. Bu ayar yalnızca yukarıdaki seçenek açıkken geçerli (tuşları Mate Notch işlediği için).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um wie viel Prozent die Lautstärke- und Helligkeitstasten pro Druck ändern. Gilt nur, solange die Option oben an ist (weil Mate Notch die Tasten bedient)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How many percent the volume and brightness keys change per press. This only applies while the option above is on (because Mate Notch handles the keys)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuántos puntos porcentuales cambian las teclas de volumen y brillo por pulsación. Solo se aplica con la opción de arriba activada (porque Mate Notch gestiona las teclas)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De combien de pour cent les touches de volume et de luminosité changent à chaque pression. S'applique uniquement quand l'option ci-dessus est activée (car Mate Notch gère les touches)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quantos por cento as teclas de volume e brilho mudam a cada toque. Só vale com a opção acima ativada (porque o Mate Notch controla as teclas)."
          }
        }
      }
    },
