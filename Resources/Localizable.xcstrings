        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando fones Bluetooth se conectam, o nome e a bateria (incluindo AirPods) aparecem brevemente."
          }
        }
      }
    },
    "Bluetooth kulaklık bağlanınca bildir (AirPods pil durumu dahil)": {
