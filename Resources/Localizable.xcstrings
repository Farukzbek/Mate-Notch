            "value": "Fokus (Nicht stören)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enfoque (No molestar)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Concentration (Ne pas déranger)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Foco (Não perturbe)"
          }
        }
      }
    },
    "Odak açıkken notch'ta ay simgesi göster": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show a moon icon in the notch while Focus is on"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mondsymbol im Notch anzeigen, solange Fokus an ist"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar un icono de luna en el notch mientras el Enfoque esté activado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher une icône de lune dans le notch tant que la Concentration est activée"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar um ícone de lua no notch enquanto o Foco estiver ativado"
          }
        }
      }
    },
    "Şu an: Açık": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now: On"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt: An"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora: activado"
          }
        },
        "fr": {
