    "Yeni sürüm çıkınca doğrulanıp kendiliğinden kurulur ve uygulama yeniden başlar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a new version is out it is verified, installed automatically and the app restarts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn eine neue Version erscheint, wird sie verifiziert, automatisch installiert und die App startet neu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando sale una nueva versión, se verifica, se instala automáticamente y la app se reinicia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand une nouvelle version sort, elle est vérifiée, installée automatiquement et l'app redémarre."
