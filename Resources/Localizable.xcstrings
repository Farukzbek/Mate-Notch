{
  "sourceLanguage": "tr",
  "strings": {
    "": {},
    "\n\nBu işlem geri alınamaz. Uygulamalar gerekli önbellek dosyalarını gerektiğinde yeniden oluşturur.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nThis can't be undone. Apps recreate the cache files they need when required."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nDas lässt sich nicht rückgängig machen. Apps erstellen benötigte Cache-Dateien bei Bedarf neu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nEsto no se puede deshacer. Las apps vuelven a crear los archivos de caché que necesiten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nCette action est irréversible. Les apps recréent les fichiers de cache dont elles ont besoin."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nIsso não pode ser desfeito. Os apps recriam os arquivos de cache de que precisam."
          }
        }
      }
    },
    "\n\nDikkat: Seçtiklerin arasında silinmesi daha etkili olan öğeler var (çevrimdışı şarkılar, Çöp Kutusu vb.).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nCaution: your selection includes items with bigger consequences (offline songs, Trash, etc.)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nAchtung: Deine Auswahl enthält Elemente mit größeren Folgen (Offline-Songs, Papierkorb usw.)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nPrecaución: tu selección incluye elementos con consecuencias mayores (canciones sin conexión, Papelera, etc.)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nAttention : votre sélection contient des éléments aux conséquences plus importantes (morceaux hors ligne, Corbeille, etc.)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nAtenção: sua seleção inclui itens com consequências maiores (músicas offline, Lixeira etc.)."
          }
        }
      }
    },
    " · %lld dosya silinemedi (kullanımda veya izin yok)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " · %lld files couldn't be deleted (in use or no permission)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " · %lld Dateien konnten nicht gelöscht werden (in Benutzung oder keine Berechtigung)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " · no se pudieron eliminar %lld archivos (en uso o sin permiso)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " · %lld fichiers n'ont pas pu être supprimés (en cours d'utilisation ou sans autorisation)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " · não foi possível excluir %lld arquivos (em uso ou sem permissão)"
          }
        }
      }
    },
    " · şarja tak": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " · plug in"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " · anschließen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " · conecta el cargador"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " · branchez le chargeur"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " · conecte o carregador"
          }
        }
      }
    },
    "\"%@\" klasörü: bu ada ait uygulama/araç önbelleği (uygulama bulunamadı). Genellikle silinirse yeniden oluşturulur.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" folder: cache of the app/tool with this name (app not found). Usually recreated when deleted."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordner „%@“: Cache der App/des Tools mit diesem Namen (App nicht gefunden). Wird beim Löschen meist neu erstellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carpeta «%@»: caché de la app o herramienta con este nombre (app no encontrada). Normalmente se vuelve a crear al eliminarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dossier « %@ » : cache de l'app ou de l'outil portant ce nom (app introuvable). Généralement recréé après suppression."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasta “%@”: cache do app ou ferramenta com esse nome (app não encontrado). Geralmente é recriada ao excluir."
          }
        }
      }
    },
    "%%%lld": {
      "localizations": {
