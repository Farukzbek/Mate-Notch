    "Ekran görüntüsü, ekrandan metin okuma ve ekran kaydı düğmeleri için gerekebilir; macOS gerekirse kendisi sorar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May be needed for the screenshot, text-from-screen and screen recording buttons; macOS asks by itself if required."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kann für die Tasten Screenshot, Text vom Bildschirm und Bildschirmaufnahme nötig sein; macOS fragt bei Bedarf selbst nach."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede ser necesario para los botones de captura, texto de pantalla y grabación de pantalla; macOS lo pide por sí mismo si hace falta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peut être nécessaire pour les boutons de capture, de texte à l'écran et d'enregistrement d'écran ; macOS le demande de lui-même si besoin."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode ser necessário para os botões de captura, texto da tela e gravação de tela; o macOS pede por conta própria se for preciso."
          }
        }
      }
    },
