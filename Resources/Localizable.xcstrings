    "Hava durumu Open-Meteo'dan gelir (anahtar gerekmez); yalnızca seçtiğin şehrin adı/konumu gönderilir, Mac'inin konumu kullanılmaz.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Wetter kommt von Open-Meteo (kein Schlüssel nötig); nur Name/Ort der gewählten Stadt wird gesendet, nie der Standort deines Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weather comes from Open-Meteo (no key needed); only the name/location of the city you pick is sent, never your Mac's location."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tiempo viene de Open-Meteo (sin clave); solo se envía el nombre/ubicación de la ciudad que elijas, nunca la ubicación de tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La météo vient d'Open-Meteo (aucune clé requise) ; seuls le nom/la position de la ville choisie sont envoyés, jamais la position de votre Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O clima vem do Open-Meteo (sem chave); só o nome/local da cidade escolhida é enviado, nunca a localização do seu Mac."
          }
        }
      }
    },
