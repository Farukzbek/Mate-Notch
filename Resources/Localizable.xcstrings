      }
    },
    "%@ Ya da Ayarlar'dan bir bulut model (Claude, ChatGPT, Gemini) bağla.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Oder verbinde in den Einstellungen ein Cloud-Modell (Claude, ChatGPT, Gemini)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Or connect a cloud model (Claude, ChatGPT, Gemini) in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ O conecta un modelo en la nube (Claude, ChatGPT, Gemini) en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Ou connectez un modèle cloud (Claude, ChatGPT, Gemini) dans les Réglages."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Ou conecte um modelo na nuvem (Claude, ChatGPT, Gemini) nos Ajustes."
          }
        }
      }
    },
