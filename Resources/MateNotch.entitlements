<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <!-- Sertleştirilmiş çalışma zamanı (hardened runtime) altında gereken izinler; Apple onayı (notarization) için şart -->
  <key>com.apple.security.automation.apple-events</key><true/>                  <!-- Spotify / Apple Music kontrolü -->
  <key>com.apple.security.device.bluetooth</key><true/>                         <!-- Bluetooth cihaz pilleri -->
  <key>com.apple.security.device.camera</key><true/>                            <!-- Kamera aynası -->
  <key>com.apple.security.personal-information.calendars</key><true/>           <!-- Takvim -->
</dict></plist>
